# Prettier owns web source code: .ts / .js / .astro / .css / .json.
# Markdown is linted by markdownlint + Vale; YAML by yamllint + actionlint.
# Keeping those out avoids two formatters fighting over the same files.

# Ignore everything
/*

# Except these files & folders
!/src
!/public
!/.github
!/scripts
!tsconfig.json
!blog.config.ts
!astro.config.ts
!.prettierrc.mjs
!package.json
!.prettierrc
!eslint.config.js

# But never markdown or YAML — those have dedicated linters above.
*.md
*.yml
*.yaml

# AstroPaper theme code follows upstream's formatting, which an older
# prettier-plugin-astro produces. Reformatting it here would conflict on
# every upstream merge. Files the blog adds to these folders stay formatted.
/src/components/*
/src/i18n/*
/src/layouts/*
/src/pages/*
/src/scripts/*
/src/styles/*
/src/types/*
/src/utils/*
!/src/components/BlogHead.astro
!/src/components/Facepile.astro
!/src/components/Webmentions.astro
!/src/pages/llms.txt.ts
!/src/pages/posts/
/src/pages/posts/*
!/src/pages/posts/[[]...slug]/
/src/pages/posts/[[]...slug]/*
!/src/pages/posts/[[]...slug]/index.md.ts
!/src/utils/*.test.ts
!/src/utils/getWebmentions.ts
!/src/utils/loadBrandFonts.ts
!/src/utils/markdownPlugins.ts
!/src/utils/og-templates/
!/src/utils/rehypeThemeImages.ts
!/src/styles/themeImages.css
!/src/styles/*.test.ts
!/src/utils/postBody.ts
