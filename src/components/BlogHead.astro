---
import { Font } from "astro:assets";
import {
  PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN,
  PUBLIC_WEBMENTION_IO_USERNAME,
} from "astro:env/client";
import { getAssetPath } from "@/utils/withBase";
import "@/styles/themeImages.css";
---

<link rel="apple-touch-icon" href={getAssetPath("apple-touch-icon.png")} />
<link rel="manifest" href={getAssetPath("site.webmanifest")} />

<Font cssVariable="--font-brand" preload />

{PUBLIC_WEBMENTION_IO_USERNAME && (
  <>
    <link
      rel="webmention"
      href={`https://webmention.io/${PUBLIC_WEBMENTION_IO_USERNAME}/webmention`}
    />
    <link
      rel="pingback"
      href={`https://webmention.io/${PUBLIC_WEBMENTION_IO_USERNAME}/xmlrpc`}
    />
  </>
)}

{
  // Injected as raw HTML: a conditional self-closing <script src> trips
  // astro-eslint-parser's preprocessor.
  PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN && import.meta.env.PROD && (
    <Fragment
      set:html={`<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "${PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN}"}'></script>`}
    />
  )
}
