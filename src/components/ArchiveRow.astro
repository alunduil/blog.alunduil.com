---
import { listingTitle, type Listing } from "@/utils/entries";
import { getPostUrl } from "@/utils/getPostPaths";
import Datetime from "./Datetime.astro";

type Props = Listing;

const { id, data, filePath } = Astro.props;
---

<li class="my-4 sm:my-6">
  <a
    href={getPostUrl(id, filePath, Astro.currentLocale)}
    class:list={[
      "text-accent inline-block text-lg font-medium",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    {listingTitle(Astro.props)}
  </a>
  {/* Archives group by publication month, so an update date would contradict the heading. */}
  <Datetime pubDatetime={data.pubDatetime} timezone={data.timezone} />
</li>
