---
import { type CollectionEntry, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import NoteSource from "@/components/NoteSource.astro";
import Webmentions from "@/components/Webmentions.astro";
import { getSortedNotes, renderNoteBody } from "@/utils/getNotes";
import { noteTitle, plainText } from "@/utils/notes";
import config from "@/config";

export async function getStaticPaths() {
  const notes = await getSortedNotes();
  return notes.map(note => ({ params: { slug: note.id }, props: { note } }));
}

type Props = { note: CollectionEntry<"notes"> };

const { note } = Astro.props;
const { pubDatetime, timezone, source } = note.data;
const title = noteTitle(note.data);

const { Content } = await render(note);

// The body is the note, so it doubles as the description.
const description = plainText(await renderNoteBody(note));
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  {description}
  {pubDatetime}
>
  <Header />

  <main id="main-content" class="app-layout mt-8" data-pagefind-body>
    <h1 class="sr-only">{title}</h1>

    <Datetime {pubDatetime} {timezone} size="lg" />

    <article id="article" class="app-prose max-w-app mt-8 w-full">
      <Content />
    </article>

    {source && <NoteSource {source} />}

    <Webmentions post={note} />
  </main>
  <Footer />
</PostLayout>
