---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import NoteCard from "@/components/NoteCard.astro";
import { getSortedNotes } from "@/utils/getNotes";
import { notesSection } from "@/utils/notes";
import config from "@/config";

const notes = await getSortedNotes();
---

<Layout title={`${notesSection.title} | ${config.site.title}`}>
  <Header />

  <Main
    pageTitle={notesSection.title}
    pageDesc={notesSection.description}
  >
    <ul>
      {notes.map(note => <NoteCard {note} />)}
    </ul>
  </Main>

  <Footer />
</Layout>
